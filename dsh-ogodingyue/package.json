{
  "name": "dsh-ogodingyue",
  "version": "0.1.0",
  "description": "OpenCode Go 用量常驻条（黑白配色版）— DeepSeek Harness 插件：聊天输入框下方常驻显示套餐余量(滚动/周/月)、总消耗 token 与金额。fork 自 OK-wx/dsh-ocgo-lite，去掉全部品牌蓝色，改为中性灰阶。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "marketplace": {
      "profiles": [
        "web"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": false
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawalixi1980/deepseek-harness.git",
    "directory": "dsh-ogodingyue"
  },
  "homepage": "https://github.com/dawalixi1980/deepseek-harness/tree/main/dsh-ogodingyue#readme"
}
